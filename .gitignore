# Build / tool outputs
zig-cache/
zig-out/
.zig-cache/

# JS/Bun deps (runtime/ package)
node_modules/

# SDD scratch (briefs, reports, ledger, review diffs)
.superpowers/

# Zigapagos
public
.zigapagos-cache
zig-pkg
scratch
result

# built island wasm artifacts
*.wasm
public_scout
.claude/worktrees

# python bytecode from the example browser tests
__pycache__/
*.pyc

# npm distribution (npm/): every package.json and README.md under the package
# directories is GENERATED by npm/gen-packages.mjs from npm/cli/targets.json +
# build.zig.zon, and the platform packages carry a binary extracted from a release
# archive. Only the sources listed in npm/README.md are tracked — committing a
# generated manifest would let its version drift from build.zig.zon.
npm/cli/package.json
npm/cli/README.md
# Staged by npm/publish.mjs from the repository's runtime/ — the @z/runtime
# sources and Bun sidecar that @zigapagos/cli ships. Not committed, so it cannot
# drift from the runtime/ the test suite exercises.
npm/cli/runtime/
npm/zigapagos/package.json
npm/zigapagos/README.md
npm/cli-*/
*.tgz

# The bare `public` rule above matches any directory named public at any
# depth, which silently swallows this Rails fixture's public asset tree.
# The fixture needs it: inventory.zig walks `app` and `public` as its two
# roots, so without it the public-asset path is untested entirely.
!tests/migrate/rails-sample/public/
