Site {
    .title = "Welcome to Zigapagos!",
    // Placeholder -- every layout's canonical link and og:url are built from
    // this via $page.absLink() (issue #151), so change it to your real
    // domain before deploying. Left as-is, they will point at example.com.
    .host_url = "https://example.com",
    .content_dir_path = "content",
    .layouts_dir_path = "layouts",
    .assets_dir_path = "assets",
    .static_assets = [
        "Temml.woff2",
    ],
    // Host targeted by the SPA release-time prerender + host-config emitter.
    // One of "zigbase" (default), "nginx", "apache".
    .deploy_target = "zigbase",
}
