<% if @user&.errors&.any? %><ul><% @user.errors.full_messages.each do |m| %><li><%= m %></li><% end %></ul><% end %><%= @user.email %><%= form_with(model: @user, url: registration_path) do |f| %><%= f.label :email %><%= f.email_field :email %><%= f.password_field :password %><%= f.submit "Sign in" %><% end %>
